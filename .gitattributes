# Deployment scripts must always have LF line endings — they're executed
# on Ubuntu, and a CRLF-corrupted shebang (`#!/usr/bin/env bash\r`) fails
# with "bad interpreter" on Linux. This repo is authored on Windows, so
# without this, a contributor's local core.autocrlf could silently
# reintroduce CRLF on commit.
*.sh text eol=lf
deployment/**/*.template text eol=lf
deployment/**/*.service text eol=lf
