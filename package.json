{
  "name": "mazad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env server/index.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx --env-file=.env server/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env server/seed.ts",
    "migrate:plate-logos": "tsx --env-file=.env server/migratePlateLogos.ts",
    "migrate:plate-listing-fields": "tsx --env-file=.env server/migratePlateListingFields.ts",
    "repair:plate-logos": "tsx --env-file=.env server/repairPlateLogoImages.ts",
    "repair:plate-images": "tsx --env-file=.env server/repairPlateImages.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/services src/lib/__tests__",
    "test:api": "next build && vitest run src/__tests__/api"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "mongoose": "^9.9.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
